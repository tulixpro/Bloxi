# Local development only. Never commit real secrets.
DATABASE_URL=postgresql://user:password@localhost:5432/vaylox
APP_BASE_URL=http://localhost:3000

# SMTP provider credentials for email verification
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=replace-with-secret
SMTP_FROM=Vaylox <no-reply@example.com>

# Admin bootstrap: both values required; use a unique email and a long random password
VAYLOX_ADMIN_USERNAME=VayloxAdmin
VAYLOX_ADMIN_EMAIL=admin@example.com
VAYLOX_ADMIN_PASSWORD=replace-with-a-long-random-secret
