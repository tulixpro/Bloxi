{
  "name": "bloxi",
  "version": "0.1.0",
  "private": true,
  "description": "Bloxi – Multiplayer-Spielwelt und kreatives Studio",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node server.js",
    "desktop": "electron .",
    "desktop:build": "electron-builder"
  },
  "dependencies": {
    "express": "^4.21.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "electron": "^35.1.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.bloxi.client",
    "productName": "Bloxi",
    "files": ["electron/**/*", "public/**/*", "server.js", "package.json"],
    "directories": { "buildResources": "build" },
    "win": { "target": ["nsis"] },
    "mac": { "target": ["dmg"] },
    "linux": { "target": ["AppImage"] }
  }
}